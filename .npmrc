strict-peer-dependencies=false
auto-install-peers=true
# React Native / Expo autolinking does not support pnpm's isolated node_modules
# layout — the native Android build generates the wrong Expo package import and
# fails to compile. Expo's documented fix for monorepos is a hoisted layout,
# which also gives Nest + Prisma the flat node_modules their bare-specifier
# runtime resolution expects.
node-linker=hoisted
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*
public-hoist-pattern[]=@prisma/*
